# Copy this file to .env and fill in your local PostgreSQL values.
# Do not commit .env to GitHub.

DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres

# JWT_SECRET=replace-with-a-long-random-secret
# OTP_SECRET=replace-with-a-different-long-random-secret
#
# Render sets RENDER=true. The API then trusts 1 proxy hop so rate limits use
# the real client IP. Override only if you know the hop count:
# TRUST_PROXY=true
# TRUST_PROXY_HOPS=1
#
# Optional. Required to use GET /api/auth/otp-mail-status?sendTest=1 in production:
# OTP_MAIL_STATUS_SECRET=a-long-random-string

# Local Gmail OTP (SMTP). Use a Gmail App Password, not the normal password.
# EMAIL_USER=yourclinic@gmail.com
# EMAIL_PASS=your-16-character-app-password
#
# Render Free blocks Gmail SMTP. For live OTP, deploy the Gmail Apps Script relay
# (HTTPS) and set these on the web service instead of relying on SMTP:
# GMAIL_APPS_SCRIPT_URL=https://script.google.com/macros/s/.../exec
# GMAIL_APPS_SCRIPT_SECRET=a-long-random-string
