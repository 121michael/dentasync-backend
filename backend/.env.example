# Copy this file to backend/.env and fill in your local PostgreSQL values.
# Do not commit .env to GitHub.

DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres

# Optional for local development (the API can use built-in dev secrets):
# JWT_SECRET=replace-with-a-long-random-secret
# OTP_SECRET=replace-with-a-different-long-random-secret
# PASSWORD_RESET_SECRET=replace-with-another-long-random-secret
# FRONTEND_URL=http://localhost:5173
#
# ESP32 RFID reader (live): set the same value in firmware DEVICE_KEY.
# RFID_DEVICE_SECRET=a-long-random-string

# Local VS Code Gmail OTP (SMTP). Use a Gmail App Password, not the normal password.
# EMAIL_USER=yourclinic@gmail.com
# EMAIL_PASS=your-16-character-app-password
#
# Render Free blocks Gmail SMTP. For live OTP, deploy the Gmail Apps Script relay
# (HTTPS) and set these on the dentasync Web Service instead of relying on SMTP:
# GMAIL_APPS_SCRIPT_URL=https://script.google.com/macros/s/.../exec
# GMAIL_APPS_SCRIPT_SECRET=a-long-random-string
