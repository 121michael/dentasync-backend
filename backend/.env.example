# Copy this file to backend/.env and fill in your local PostgreSQL values.
# Do not commit .env to GitHub.

DB_USER=postgres
DB_PASSWORD=your_postgres_password
DB_HOST=localhost
DB_PORT=5432
DB_NAME=postgres

# Optional for local development (the API can use built-in dev secrets):
# JWT_SECRET=replace-with-a-long-random-secret
# OTP_SECRET=replace-with-a-different-long-random-secret
# PASSWORD_RESET_SECRET=replace-with-another-long-random-secret
# FRONTEND_URL=http://localhost:5173
#
# ESP32 RFID reader (live). Firmware DEVICE_KEY defaults to dentasync-esp32-desk.
# Set this on Render only if you want a different key than the firmware default.
# RFID_DEVICE_SECRET=a-long-random-string

# Local VS Code Gmail OTP (SMTP). Use a Gmail App Password, not the normal password.
# EMAIL_USER=yourclinic@gmail.com
# EMAIL_PASS=your-16-character-app-password
#
# Render Free blocks Gmail SMTP. Deploy backend/gmail-https-relay.gs as a Web App
# so OTP, password reset, and authorized prescription PDFs send over HTTPS:
# GMAIL_APPS_SCRIPT_URL=https://script.google.com/macros/s/.../exec
# GMAIL_APPS_SCRIPT_SECRET=a-long-random-string
#
# Clinic timezone used for appointment reminder scheduling (default Asia/Manila).
# CLINIC_TIMEZONE=Asia/Manila
#
# Semaphore SMS (keep these on the backend only; never expose them to the frontend).
# SEMAPHORE_API_KEY=your-semaphore-api-key
# SEMAPHORE_SENDER_NAME=AMETHYST
# CLINIC_NAME=Amethyst Dental Clinic
#
# Prescription PDF email uses the HTTPS relay on Render (or SMTP locally).
# Do not send to real patients in development.
# PRESCRIPTION_EMAIL_OVERRIDE=clinic-test@example.com
#
# Admin Backup & Recovery. Legacy archives stay in admin_portal_backups.payload.
# Independent off-site copies require S3-compatible credentials. Until those are set,
# the Admin page shows "Off-site Backup Not Configured".
# BACKUP_S3_BUCKET=
# BACKUP_S3_REGION=ap-southeast-1
# BACKUP_S3_ENDPOINT=
# BACKUP_S3_FORCE_PATH_STYLE=true
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_PREFIX=dentasync-backups
# BACKUP_ENCRYPTION_KEY=a-long-random-backup-encryption-key
# BACKUP_OFFSITE_DIR=C:\DentaSync-git\backend\uploads\backup-offsite
# Independent automation (no browser). Render Cron Job:
#   POST /api/internal/backups/run  header x-backup-cron-secret
# or: npm run backup:scheduled
# BACKUP_CRON_SECRET=a-long-random-cron-secret
# BACKUP_EXTERNAL_SCHEDULER=true
# Local S3-compatible mock for tests: npm run backup:s3-mock
# BACKUP_PITR_AVAILABLE=false
# BACKUP_ALLOW_PRODUCTION_RESTORE=false
# BACKUP_SKIP_PG_DUMP=false
# Run `npm run migrate:admin-backups` and `npm run migrate:admin-backup-offsite`.
